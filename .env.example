# نسخ هذا الملف إلى .env.local ثم ملء القيم. لا تضع أسرارًا حقيقية هنا.

# قاعدة PostgreSQL (مثال: Neon أو Supabase أو Vercel Postgres أو محلي)
DATABASE_URL=

# كلمة مرور الدخول للتطبيق (مطلوبة في الإنتاج)
APP_PASSWORD=
# سر توقيع جلسة الدخول، أي نص طويل عشوائي
APP_SESSION_SECRET=

# مزود نماذج الذكاء الاصطناعي: anthropic أو openai (أو أي خدمة متوافقة مع واجهة OpenAI)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# اختياري: رابط أساس مخصص لخدمات متوافقة مع OpenAI
AI_BASE_URL=
# اختياري: مهلة الطلب بالمللي ثانية
AI_TIMEOUT_MS=60000
# اختياري: الحد الأقصى لعدد الطلبات لتوليد السكريبتات في الساعة الواحدة
GENERATION_RATE_LIMIT_PER_HOUR=30

# اختياري: بيانات حساب المالك (تُنشأ تلقائيًا عند أول تشغيل)
OWNER_EMAIL=
OWNER_DISPLAY_NAME=

# اختياري: قاعدة اختبار منفصلة لتشغيل اختبارات التكامل (لا تستخدم قاعدة الإنتاج)
TEST_DATABASE_URL=
