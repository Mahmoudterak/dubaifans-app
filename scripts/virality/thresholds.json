{
  "_comment": "Single source for every threshold used by analyze.py and virality.html. Edit here, then run sync_thresholds.py. These are reasoned defaults, not fitted to labelled data.",
  "sample_fps": 10,
  "frame_width": 160,
  "frame_height": 90,
  "score_bands": { "high": 85, "mid": 70 },
  "overall_weights": { "visual": 0.25, "attention": 0.35, "memory": 0.15, "hook": 0.25 },
  "motion": { "flow_norm_px": 1.5, "diff_norm": 0.04 },
  "cuts": { "diff_ratio_of_median": 4.0, "min_diff": 0.06, "density_full_per_10s": 4.0 },
  "contrast": { "norm": 0.18, "low": 0.10 },
  "colour": { "norm": 0.25 },
  "static": { "motion_eps": 0.2, "high_share": 0.6 },
  "audio": {
    "silence_db": -50,
    "quiet_db": -40,
    "dyn_norm_db": 6,
    "low_dynamics": 0.2,
    "loud_db": -18,
    "fast_centroid_hz": 2500,
    "bright_high_ratio": 0.35
  },
  "speech": { "min_peaks_per_s": 2, "max_peaks_per_s": 8, "low_share": 0.2 },
  "hook": { "seconds": 3, "motion_norm": 0.04, "contrast_norm": 0.18 },
  "tags": {
    "fast_rhythm_cuts_per_10s": 3.0,
    "fast_rhythm_motion": 0.6,
    "calm_motion": 0.25,
    "calm_cuts_per_10s": 0.5,
    "high_energy_loud_db": -18,
    "high_energy_motion": 0.5,
    "sharp_contrast": 0.7,
    "low_contrast": 0.3
  }
}
